<odoo>
    <record id="action_report_deca" model="ir.actions.report">
        <field name="name">DeCA</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_es_deca_oca.report_deca</field>
        <field name="report_file">l10n_es_deca_oca.report_deca</field>
        <field name="print_report_name">'DeCA - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_type">report</field>
        <field name="domain">[('picking_type_code', '=', 'outgoing')]</field>
    </record>
</odoo>
