<odoo>
    <record id="view_picking_type_form_inherit_deca" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.l10n_es_deca_oca</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='second']" position="inside">
                <group string="DeCA" name="deca" invisible="code != 'outgoing'">
                    <field name="deca_required" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
