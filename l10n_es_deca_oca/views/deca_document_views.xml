<odoo>
    <record id="view_l10n_es_deca_document_list" model="ir.ui.view">
        <field name="name">l10n_es.deca.document.list</field>
        <field name="model">l10n_es.deca.document</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="picking_id" />
                <field name="version" />
                <field name="date" />
                <field name="user_id" optional="show" />
                <field name="change_reason" optional="show" />
                <field name="attachment_id" widget="many2one_binary" optional="show" />
                <field name="carrier_name" optional="show" />
                <field name="vehicle_plate" optional="show" />
                <field name="trailer_plate" optional="show" />
                <field name="gross_weight" optional="show" />
                <field name="transport_date" optional="hide" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"
                />
            </list>
        </field>
    </record>

    <record id="view_l10n_es_deca_document_form" model="ir.ui.view">
        <field name="name">l10n_es.deca.document.form</field>
        <field name="model">l10n_es.deca.document</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="picking_id" />
                            <field name="version" />
                            <field name="is_current" />
                        </group>
                        <group>
                            <field name="date" />
                            <field name="user_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <group>
                        <field name="attachment_id" widget="many2one_binary" />
                        <field name="change_reason" />
                    </group>
                    <group>
                        <group string="Contractual shipper">
                            <field name="shipper_name" />
                            <field name="shipper_vat" />
                            <field name="shipper_address" />
                        </group>
                        <group string="Effective carrier">
                            <field name="carrier_name" />
                            <field name="carrier_vat" />
                            <field name="carrier_address" />
                            <field name="driver_name" />
                            <field name="vehicle_plate" />
                            <field name="trailer_plate" />
                        </group>
                    </group>
                    <group>
                        <group string="Origin">
                            <field name="origin_address" nolabel="1" colspan="2" />
                        </group>
                        <group string="Destination">
                            <field name="destination_name" />
                            <field name="destination_address" />
                        </group>
                    </group>
                    <group>
                        <group string="Goods">
                            <field name="transport_date" />
                            <field name="gross_weight" />
                            <field name="goods_description" />
                        </group>
                        <group string="Remarks">
                            <field name="special_authorization" />
                            <field name="notes" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_es_deca_document_search" model="ir.ui.view">
        <field name="name">l10n_es.deca.document.search</field>
        <field name="model">l10n_es.deca.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="picking_id" />
                <field name="carrier_name" />
                <field name="vehicle_plate" />
                <group expand="0" string="Group By">
                    <filter
                        name="group_picking"
                        string="Transfer"
                        context="{'group_by': 'picking_id'}"
                    />
                    <filter
                        name="group_date"
                        string="Issue date"
                        context="{'group_by': 'date:day'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_es_deca_document" model="ir.actions.act_window">
        <field name="name">DeCA versions</field>
        <field name="res_model">l10n_es.deca.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No DeCA issued yet</p>
            <p
            >Every issue of a DeCA keeps an immutable copy of the data printed on it.</p>
        </field>
    </record>

    <menuitem
        id="menu_l10n_es_deca_document"
        name="DeCA versions"
        parent="stock.menu_warehouse_report"
        action="action_l10n_es_deca_document"
        sequence="200"
    />
</odoo>
